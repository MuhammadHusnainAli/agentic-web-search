# ---------------------------------------------------------------------------
# agentic-web-search configuration
# Copy to `.env` (loaded automatically) or pass as real environment variables.
# Real environment variables always override values in `.env`.
# ---------------------------------------------------------------------------

# --- Server -----------------------------------------------------------------
HOST=0.0.0.0
PORT=8080
# Tokio worker threads; 0 = one per CPU core.
WORKER_THREADS=0
# pretty | json  (use json in production for log shipping)
LOG_FORMAT=pretty
# Standard tracing filter, e.g. info,agentic_web_search=debug
RUST_LOG=info

# --- Authentication ---------------------------------------------------------
# Comma-separated API keys (>= 16 chars each). Clients send them as
#   X-API-Key: <key>      or      Authorization: Bearer <key>
# Generate one with:  openssl rand -hex 24
API_KEYS=change-me-to-a-long-random-key-0001
# Set to false only for local development; then clients are limited per IP.
REQUIRE_AUTH=true

# --- Limits & backpressure --------------------------------------------------
# Sustained requests/second per API key, plus burst allowance.
RATE_LIMIT_PER_SEC=50
RATE_LIMIT_BURST=100
# In-flight requests above this are shed with 503 instead of queueing.
MAX_CONCURRENT_REQUESTS=10000
# Hard deadline for a whole API request (seconds).
REQUEST_TIMEOUT_SECS=30
# Allow any CORS origin (browser clients). Off by default.
CORS_ALLOW_ANY=false
# Response compression for clients sending Accept-Encoding: fast | off.
# `off` maximises throughput on a LAN / sidecar deployment.
COMPRESSION=fast

# --- Search behaviour -------------------------------------------------------
# Engine used when a request doesn't specify one: auto | bing | brave |
# duckduckgo | yahoo | mojeek | google
DEFAULT_ENGINE=auto
# Order tried by engine=auto until one returns results.
FALLBACK_ENGINES=bing,brave,duckduckgo,yahoo,mojeek,google
# auto (HTTP first, browser fallback) | http | browser
DEFAULT_FETCH_MODE=auto
# <country>-<language>
DEFAULT_REGION=us-en
# Max SERP pages a single request may ask for (1-20).
MAX_PAGES=5
MAX_QUERY_LEN=512
# After an engine blocks plain HTTP, go straight to the browser for this long.
BLOCK_COOLDOWN_SECS=120
# strategy=fallback: if an engine hasn't answered after this many ms, start the
# next one in parallel (first with results wins). 0 = always race.
HEDGE_DELAY_MS=1200
# strategy=merge: after the first engine answers, wait at most this long (ms)
# for the rest before fusing what has arrived.
MERGE_GRACE_MS=1500

# --- Upstream fetching ------------------------------------------------------
UPSTREAM_TIMEOUT_SECS=10
# Global cap on concurrent upstream HTTP requests.
MAX_UPSTREAM_CONCURRENCY=256
# Responses are truncated beyond this many bytes (memory guard).
MAX_BODY_BYTES=3145728
# Optional egress proxy: http://user:pass@host:port or socks5://host:port
# Strongly recommended in production: engines rate-limit datacenter IPs.
PROXY_URL=
# Optional comma-separated User-Agent pool (rotated round-robin).
# USER_AGENTS=Mozilla/5.0 (...),Mozilla/5.0 (...)

# Optional per-engine base URL overrides (mirrors, testing):
# ENGINE_BING_URL=https://www.bing.com/
# ENGINE_BRAVE_URL=https://search.brave.com/
# ENGINE_DUCKDUCKGO_URL=https://html.duckduckgo.com/
# ENGINE_GOOGLE_URL=https://www.google.com/
# ENGINE_YAHOO_URL=https://search.yahoo.com/
# ENGINE_MOJEEK_URL=https://www.mojeek.com/

# include_suggestions / include_answer: deadline (ms) for the engines' suggestion
# and instant-answer endpoints. They run alongside the search and never delay it longer.
EXTRAS_TIMEOUT_MS=2000

# --- Cache ------------------------------------------------------------------
CACHE_TTL_SECS=900
# Memory budget for cached results (MiB). Identical in-flight requests are
# always coalesced into one upstream fetch.
CACHE_MAX_MB=256

# --- Content extraction (include_content=true) -----------------------------
CONTENT_MAX_CHARS=8000
CONTENT_MAX_CONCURRENCY=32
CONTENT_MAX_RESULTS=10
# Deadline for all content fetches of one search (per-request: content_timeout_ms).
CONTENT_TIMEOUT_SECS=5
# When the CPU is saturated, at most this many extractions wait per core; further
# pages are skipped with content_error "server busy" so latency stays bounded.
CONTENT_PARSE_QUEUE_PER_CORE=8
# Size cap for PDF results (MiB); larger PDFs get a content_error.
CONTENT_MAX_PDF_MB=10
# Extracted page text is cached across searches (MiB).
CONTENT_CACHE_MB=64
# SSRF guard: never fetch private/loopback addresses. Keep false in production.
CONTENT_ALLOW_PRIVATE_IPS=false

# --- Headless browser (requires the `browser` cargo feature) ---------------
BROWSER_ENABLED=true
# Auto-detected when empty (google-chrome, chromium, chromium-browser, ...).
BROWSER_EXECUTABLE=
# Concurrent tabs; each costs roughly 20-60 MB RAM.
BROWSER_MAX_TABS=4
BROWSER_PAGE_TIMEOUT_SECS=20
